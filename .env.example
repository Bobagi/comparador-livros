# Copie para .env e gere uma chave forte:
#   python3 -c "import secrets; print('LIVROS_KEY=' + secrets.token_urlsafe(32))" > .env
# A LIVROS_KEY autentica o POST de resultados vindo da extensao. Ela e injetada
# no config.js da extensao pelo scripts/build-extension.py na hora de empacotar.
LIVROS_KEY=troque-por-um-token-aleatorio

# Copie para .env e gere uma chave forte:
#   python3 -c "import secrets; print('LIVROS_KEY=' + secrets.token_urlsafe(32))" > .env
# A LIVROS_KEY e a chave MASTER (dev local / testes via curl). A extensao NAO
# usa mais essa chave: ela se registra sozinha no backend (POST /api/installs)
# e recebe um token proprio por instalacao.
LIVROS_KEY=troque-por-um-token-aleatorio

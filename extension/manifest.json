{
  "manifest_version": 3,
  "name": "Livros Bobagi - Coletor",
  "version": "0.2.0",
  "description": "Busca ofertas de livros nas lojas brasileiras a partir do seu navegador, a pedido de livros.bobagi.space. Nao le sua navegacao.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["offscreen", "storage", "scripting"],
  "host_permissions": [
    "https://livros.bobagi.space/*",
    "https://*.mercadolivre.com.br/*",
    "https://*.amazon.com.br/*",
    "https://*.estantevirtual.com.br/*",
    "https://*.olx.com.br/*",
    "https://*.enjoei.com.br/*",
    "https://*.shopee.com.br/*"
  ],
  "background": { "service_worker": "sw.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://livros.bobagi.space/*"],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    }
  ]
}

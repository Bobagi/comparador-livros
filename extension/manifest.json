{
  "manifest_version": 3,
  "name": "Farolivro",
  "version": "0.3.0",
  "description": "Fareje o menor preco de um livro, novo ou usado, em 6 lojas ao mesmo tempo, a partir do seu navegador. So age quando voce pede uma busca; nao le sua navegacao.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["offscreen", "storage", "scripting"],
  "host_permissions": [
    "https://livros.bobagi.space/*",
    "https://*.mercadolivre.com.br/*",
    "https://*.amazon.com.br/*",
    "https://*.estantevirtual.com.br/*",
    "https://*.olx.com.br/*",
    "https://*.enjoei.com.br/*",
    "https://*.shopee.com.br/*"
  ],
  "background": { "service_worker": "sw.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://livros.bobagi.space/*"],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
